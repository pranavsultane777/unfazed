PORT=5000
MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_long_random_jwt_secret
RAZORPAY_KEY_ID=your_razorpay_test_key
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Config-driven platform fee as a decimal rate: 0.05 = 5%
PLATFORM_FEE_RATE=0.05
DEFAULT_TIER_KEY=free
# Optional tax display for the GST-style invoice. 0 means no tax line.
INVOICE_TAX_PERCENT=0

DEFAULT_SESSION_PRICE=0

# Comma-separated allowed frontend origins in production; use * only for local demos.
CORS_ORIGIN=http://localhost:5173
# Notification sweep interval in milliseconds (15 minutes by default).
NOTIFICATION_SWEEP_INTERVAL_MS=900000

# Optional local demo data seed
SEED_THERAPIST_EMAIL=demo.therapist@example.com
SEED_THERAPIST_PASSWORD=change-this-before-running
SEED_THERAPIST_NAME=Demo Therapist
SEED_THERAPIST_SLUG=demo-therapist
SEED_SESSION_PRICE=1500
SEED_CLIENT_EMAIL=demo.client@example.com
SEED_CLIENT_NAME=Demo Client
